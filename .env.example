PORT=8090
POSTGRES_PASSWORD=local-db-password
APP_DB_PASSWORD=local-app-password
ADMIN_TOKEN=relaydesk-local-admin
DEMO_WEBHOOK_SECRET=relaydesk-demo-signing-secret
